FROM python:3.12-slim

WORKDIR /app

COPY requirements-mcp.txt .
# cffi (pulled in via mcp -> pyjwt[crypto] -> cryptography) publishes no
# armv7l wheel, so it compiles from source on arm/v7; gcc is dropped after.
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev libffi-dev \
 && pip install --no-cache-dir -r requirements-mcp.txt \
 && apt-get purge -y --auto-remove gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*

COPY mcp_server ./mcp_server

# MCP speaks JSON-RPC over stdio; run the container with `docker run -i`.
CMD ["python", "mcp_server/server.py"]
